# Copy to backend/.env. Only installed local models are used. No automatic downloads.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REQUIREMENTS_MODEL=qwen3.5:4b
OLLAMA_SUPERVISOR_MODEL=qwen3.5:4b
OLLAMA_FURNITURE_MODEL=qwen3.5:4b
OLLAMA_MATERIALS_MODEL=qwen3.5:4b
OLLAMA_DESIGN_MODEL=qwen3:8b
OLLAMA_CORRECTION_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
# To use the installed alternative, change OLLAMA_EMBEDDING_MODEL to nomic-embed-text:latest.
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_FORCE_CPU=false
OLLAMA_CPU_FALLBACK=true
# Calls are serialized and keep_alive=0 unloads models after requests.
CV_PROVIDER=opencv
# Optional trusted Python factory (module:function) implementing SegmentationModel.
CV_SEGMENTATION_FACTORY=
CATALOGUE_PROVIDER=local_json
CATALOGUE_JSON_PATH=data/catalogue.json
# Optional trusted provider factory for an authorized feed. No scraper is included.
CATALOGUE_PROVIDER_FACTORY=
# Project database and imported reference images stay on this computer.
ARCHAI_DATA_DIR=.local
